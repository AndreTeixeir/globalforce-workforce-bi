# Interface web — login obrigatório (HTTP Basic Auth)
APP_USERNAME=admin
APP_PASSWORD=troque_por_uma_senha_forte
APP_PORT=5000
# Use 1 só durante o desenvolvimento; nunca deixe ligado com o app exposto
FLASK_DEBUG=0

# Banco de dados MySQL
DB_USER=root
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=3306
DB_NAME=workforce_bi

# Metabase — link público do dashboard usado para gerar os PDFs
# (Metabase > dashboard > Compartilhar > Link público)
METABASE_DASHBOARD_URL=http://localhost:3000/public/dashboard/SEU-UUID-AQUI
# Folga extra (segundos) após a página carregar, para os gráficos terminarem
REPORT_EXTRA_WAIT_SECONDS=5

# E-mail (Gmail recomendado)
# Para Gmail: ative verificação em 2 etapas e gere uma "Senha de App" em:
# https://myaccount.google.com/apppasswords
SENDER_EMAIL=seu-email@gmail.com
SENDER_PASSWORD=sua-senha-de-app
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# WhatsApp via CallMeBot (gratuito) — notificação para um número de TESTE
# 1. Adicione o contato +34 613 01 49 37 no seu WhatsApp
# 2. Envie a mensagem: I allow callmebot to send me messages
# 3. Você receberá sua API key em segundos
# A chave só envia para o número que fez o cadastro: informe esse número abaixo.
CALLMEBOT_API_KEY=sua_api_key_aqui
CALLMEBOT_PHONE=+55DDDSEUNUMERO

# Opcional: caminho do CSV usado por etl/pipeline.py
# CSV_PATH=globalforce_usa_3years_2023_2025.csv
